# ---------------------------------------------------------------------------
# Variables del CLIENTE (app React). Vite solo expone las que empiezan por VITE_.
# No hay secretos: el único backend es el proxy PHP de datos oficiales de SELAE.
# ---------------------------------------------------------------------------

# URL del proxy PHP de resultados. Déjalo vacío o sin definir si la app y el PHP
# están en el MISMO dominio (se usará /api/loteria-oficial.php). Si están en
# dominios distintos, pon la URL completa, p. ej.:
# VITE_OFICIAL_PROXY_URL=https://loteriasmalaga70.com/api/loteria-oficial.php
VITE_OFICIAL_PROXY_URL=

# Página de inicio a la que vuelve el botón "Volver" de la cabecera.
# Por defecto: https://www.loteriasmalaga70.com/
# VITE_HOME_URL=https://www.loteriasmalaga70.com/
VITE_HOME_URL=
